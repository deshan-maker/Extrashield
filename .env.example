# Copy this file to .env and fill in real values.

# PostgreSQL connection string.
# Local Postgres example:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/dwp_core"
# Or use a free hosted Postgres (Supabase, Neon, Railway) — Supabase
# gives you a connection string under Project Settings > Database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/dwp_core"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API key (free) — used by the AI Chat Assistant.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# Groq API key (free, no credit card) — used by the AI Chat Assistant.
# Get one at https://console.groq.com/keys
GROQ_API_KEY="replace-with-your-groq-api-key"

# Anthropic API key, for the AI Chat Assistant on the customer dashboard.
# Get one from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
